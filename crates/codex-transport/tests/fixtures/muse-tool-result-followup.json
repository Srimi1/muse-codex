{
  "model": "gpt-fixture",
  "instructions": "Use tools when required.",
  "input": [
    {
      "type": "message",
      "role": "developer",
      "content": "Keep Muse in control of the agent loop."
    },
    {
      "type": "message",
      "role": "user",
      "content": "Read fixture.txt."
    },
    {
      "type": "reasoning",
      "id": "rs_fixture",
      "summary": [],
      "encrypted_content": "encrypted-fixture"
    },
    {
      "type": "function_call",
      "id": "fc_fixture",
      "call_id": "call_fixture",
      "name": "muse.read_file",
      "arguments": "{\"path\":\"fixture.txt\"}"
    },
    {
      "type": "function_call_output",
      "call_id": "call_fixture",
      "name": "read_file",
      "output": "fixture contents"
    },
    {
      "type": "custom_tool_call",
      "id": "ctc_fixture",
      "call_id": "custom_fixture",
      "name": "exec",
      "input": "fixture input"
    },
    {
      "type": "custom_tool_call_output",
      "call_id": "custom_fixture",
      "name": "exec",
      "output": "fixture output"
    }
  ],
  "tools": [
    {
      "type": "namespace",
      "name": "muse",
      "description": "Muse agent tools",
      "tools": [
        {
          "type": "function",
          "name": "read_file",
          "description": "Read a file",
          "parameters": {
            "type": "object",
            "properties": { "path": { "type": "string" } },
            "required": ["path"]
          }
        }
      ]
    }
  ],
  "store": false,
  "stream": true
}
